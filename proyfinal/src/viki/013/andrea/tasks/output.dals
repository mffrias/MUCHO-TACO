pred postcondition_roops_core_objects_BinomialHeap_generateInvariant[
  roops_core_objects_BinomialHeapNode_child':univ->univ,
  roops_core_objects_BinomialHeapNode_degree':univ->univ,
  roops_core_objects_BinomialHeapNode_key':univ->univ,
