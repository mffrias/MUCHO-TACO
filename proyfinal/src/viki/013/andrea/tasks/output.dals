pred precondition_roops_core_objects_BinomialHeap_generateInvariant[
  roops_core_objects_BinomialHeapNode_child:univ->univ,
  roops_core_objects_BinomialHeapNode_degree:univ->univ,
  roops_core_objects_BinomialHeapNode_key:univ->univ,
  roops_core_objects_BinomialHeapNode_parent:univ->univ,
  roops_core_objects_BinomialHeapNode_sibling:univ->univ,
  roops_core_objects_BinomialHeap_Nodes:univ->univ,
  roops_core_objects_BinomialHeap_size:univ->univ,
  thiz:univ,
  throw:univ
]{
   equ[throw,
      null]
   and 
   roops_core_objects_BinomialHeap_object_invariant[roops_core_objects_BinomialHeapNode_child,
                                                   roops_core_objects_BinomialHeapNode_degree,
                                                   roops_core_objects_BinomialHeapNode_key,
                                                   roops_core_objects_BinomialHeapNode_parent,
                                                   roops_core_objects_BinomialHeapNode_sibling,
                                                   roops_core_objects_BinomialHeap_Nodes,
                                                   roops_core_objects_BinomialHeap_size,
                                                   thiz]
   and 
   roops_core_objects_BinomialHeap_requires[]

}

pred roops_core_objects_BinomialHeapCondition0[
  thiz:univ
]{
   isEmptyOrNull[thiz]
   or 
   isEmptyOrNull[thiz]

}

pred roops_core_objects_BinomialHeapCondition1[
  thiz:univ
]{
   not (
     isEmptyOrNull[thiz]
     or 
     isEmptyOrNull[thiz]
   )

}

pred roops_core_objects_BinomialHeapCondition2[
  exit_stmt_reached:univ,
  throw:univ
]{
   (
     throw=null)
   and 
   (
     exit_stmt_reached=false)
   and 
   (
     true=true)

}

pred roops_core_objects_BinomialHeapCondition3[
  exit_stmt_reached:univ,
  throw:univ
]{
   not (
     (
       throw=null)
     and 
     (
       exit_stmt_reached=false)
     and 
     (
       true=true)
   )

}

pred roops_core_objects_BinomialHeap_object_invariant[
  roops_core_objects_BinomialHeapNode_child:univ->univ,
  roops_core_objects_BinomialHeapNode_degree:univ->univ,
  roops_core_objects_BinomialHeapNode_key:univ->univ,
  roops_core_objects_BinomialHeapNode_parent:univ->univ,
  roops_core_objects_BinomialHeapNode_sibling:univ->univ,
  roops_core_objects_BinomialHeap_Nodes:univ->univ,
  roops_core_objects_BinomialHeap_size:univ->univ,
  thiz:univ
]{
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 (
                   neq[n.roops_core_objects_BinomialHeapNode_child,
                      null]
                   and 
                   neq[n.roops_core_objects_BinomialHeapNode_sibling,
                      null]
                 )
                 implies 
                         (
                           all m:null+roops_core_objects_BinomialHeapNode | {
                             equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling],m],
                                true]
                             implies 
                                     equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_sibling,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling],m],
                                        false]
                           
                           }
                         )
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling],n],
          true]
       implies 
               (
                 (
                   neq[n.roops_core_objects_BinomialHeapNode_sibling,
                      null]
                   implies 
                           lt[n.roops_core_objects_BinomialHeapNode_degree,
                             (n.roops_core_objects_BinomialHeapNode_sibling).roops_core_objects_BinomialHeapNode_degree]
                 )
                 and 
                 equ[n.roops_core_objects_BinomialHeapNode_parent,
                    null]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_parent,
                    null]
                 implies 
                         gte[n.roops_core_objects_BinomialHeapNode_key,
                            (n.roops_core_objects_BinomialHeapNode_parent).roops_core_objects_BinomialHeapNode_key]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               gte[n.roops_core_objects_BinomialHeapNode_degree,
                  0]
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_child,
                    null]
                 implies 
                         equ[n.roops_core_objects_BinomialHeapNode_degree,
                            fun_set_size[fun_reach[n.roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling]]]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_child,
                    null]
                 implies 
                         (
                           all m:null+roops_core_objects_BinomialHeapNode | {
                             equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling],m],
                                true]
                             implies 
                                     equ[m.roops_core_objects_BinomialHeapNode_parent,
                                        n]
                           
                           }
                         )
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_child,
                    null]
                 implies 
                         equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
                            false]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling],n],
          true]
       implies 
               gte[n.roops_core_objects_BinomialHeapNode_key,
                  0]
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 (
                   neq[n.roops_core_objects_BinomialHeapNode_sibling,
                      null]
                   and 
                   neq[n.roops_core_objects_BinomialHeapNode_parent,
                      null]
                 )
                 implies 
                         gt[n.roops_core_objects_BinomialHeapNode_degree,
                           (n.roops_core_objects_BinomialHeapNode_sibling).roops_core_objects_BinomialHeapNode_degree]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 equ[n.roops_core_objects_BinomialHeapNode_child,
                    null]
                 implies 
                         equ[n.roops_core_objects_BinomialHeapNode_degree,
                            0]
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 (
                   neq[n.roops_core_objects_BinomialHeapNode_child,
                      null]
                   and 
                   neq[n.roops_core_objects_BinomialHeapNode_sibling,
                      null]
                 )
                 implies 
                         (
                           all m:null+roops_core_objects_BinomialHeapNode | {
                             liftExpression[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_sibling,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling],m]]
                             implies 
                                     equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling],m],
                                        false]
                           
                           }
                         )
               )
     
     }
   )
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_sibling,
                    null]
                 implies 
                         equ[fun_set_contains[fun_reach[n.roops_core_objects_BinomialHeapNode_sibling,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
                            false]
               )
     
     }
   )
   and 
   equ[thiz.roops_core_objects_BinomialHeap_size,
      fun_set_size[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child]]]
   and 
   (
     all n:null+roops_core_objects_BinomialHeapNode | {
       equ[fun_set_contains[fun_reach[thiz.roops_core_objects_BinomialHeap_Nodes,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_sibling+roops_core_objects_BinomialHeapNode_child],n],
          true]
       implies 
               (
                 neq[n.roops_core_objects_BinomialHeapNode_child,
                    null]
                 implies 
                         equ[fun_set_size[fun_reach[(n.roops_core_objects_BinomialHeapNode_child).roops_core_objects_BinomialHeapNode_child,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling]],
                            fun_set_size[fun_reach[(n.roops_core_objects_BinomialHeapNode_child).roops_core_objects_BinomialHeapNode_sibling,roops_core_objects_BinomialHeapNode,roops_core_objects_BinomialHeapNode_child+roops_core_objects_BinomialHeapNode_sibling]]]
               )
     
     }
